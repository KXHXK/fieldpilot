APP_NAME=HelloAgents Trip Planner
APP_VERSION=0.1.0
USE_MOCK_LLM=true
USE_MOCK_TOOLS=true
USE_MOCK_IMAGES=true

# LLM API. Keep USE_MOCK_LLM=true while developing to avoid spending credits.
OPENAI_API_KEY=your_llm_api_key_here
OPENAI_BASE_URL=https://api.moonshot.cn/v1
MODEL_NAME=kimi-k2.6

# Search / map / image services. Fill these when the related chapter needs them.
TAVILY_API_KEY=your_tavily_api_key_here
AMAP_API_KEY=your_amap_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Frontend origins for CORS.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://kxh-trip-planner.netlify.app"]
